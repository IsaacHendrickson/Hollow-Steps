// How much a run varies from the authored dungeon (docs/variety.md). An assets/variety.ron
// replaces this file whole; F5 does not re-read it, so restart the game after editing it.
// This embedded default never flips: it keeps the dungeon exactly as it was authored.
(
    flip_percent: 0.0,   // chance, in percent (0 to 100), that a run plays the whole dungeon mirrored
                         // left to right; the F4 window's "Flip next run" can force it either way
)
