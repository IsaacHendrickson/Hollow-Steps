        ]),
        (name: "fire", actions: [
            shoot_projectile(speed: 280.0, damage: 1, lifetime_secs: 3.0, size: (12.0, 12.0),
                aim: AtPlayer, count: 3, spread_degrees: 15.0, telegraph_secs: 0.4, recovery_secs: 1.2),
        ], transitions: [
            (target: "retreat", condition: player_distance_less_than(200.0)),
            (target: "distance", condition: action_finished),
        ]),
    ],
