// The Ash Warden: a hulking ash-grey guardian with an ember core, a three-spike crown, a glowing
// visor slit and a plume of ash trailing from its shoulders. Original design.
(
    pose_map: {"head": "head", "torso": "torso", "hand_l": "hand_l", "hand_r": "hand_r", "foot_l": "foot_l", "foot_r": "foot_r", "tail": "plume"},
    // Heavier and slower than the humanoid template: it should look like it has weight.
    follow: (stiffness: 90.0, damping: 16.0),
    follow_overrides: {
        "plume": (stiffness: 50.0, damping: 6.0),
        "hand_l": (stiffness: 70.0, damping: 11.0),
        "hand_r": (stiffness: 70.0, damping: 11.0),
    },
    idle: [
        (point: "torso", amplitude: (0.0, 0.012), period_secs: 2.6, phase_offset_secs: 0.0),
        (point: "head", amplitude: (0.0, 0.01), period_secs: 2.6, phase_offset_secs: 0.2),
        (point: "hand_r", amplitude: (0.0, 0.02), period_secs: 2.6, phase_offset_secs: 0.4),
        (point: "plume", amplitude: (0.03, 0.03), period_secs: 1.7, phase_offset_secs: 0.0),
    ],
    points: {
        "head": (rest: (0.06, -0.3)),
        "torso": (rest: (0.0, 0.05)),
        "hand_l": (rest: (-0.3, 0.22)),
        "hand_r": (rest: (0.34, 0.22)),
        "foot_l": (rest: (-0.17, 0.44)),
        "foot_r": (rest: (0.17, 0.44)),
        "plume": (rest: (-0.44, -0.18)),
    },
    parts: [
        (name: "plume", shape: Line, from: Some("torso"), to: Some("plume"), size: (0.07, 0.07), rotation: 0.0, color_slot: accent),
        (name: "leg_l", shape: Line, from: Some("torso"), to: Some("foot_l"), size: (0.15, 0.15), rotation: 0.0, color_slot: secondary),
        (name: "leg_r", shape: Line, from: Some("torso"), to: Some("foot_r"), size: (0.15, 0.15), rotation: 0.0, color_slot: secondary),
        (name: "arm_l", shape: Line, from: Some("torso"), to: Some("hand_l"), size: (0.14, 0.14), rotation: 0.0, color_slot: secondary),
        (name: "arm_r", shape: Line, from: Some("torso"), to: Some("hand_r"), size: (0.16, 0.16), rotation: 0.0, color_slot: secondary),
        (name: "torso", shape: Rect, anchor: Some("torso"), offset: Some((0.0, 0.0)), size: (0.62, 0.5), rotation: 0.0, color_slot: primary),
        (name: "shoulder_l", shape: Rect, anchor: Some("torso"), offset: Some((-0.3, -0.17)), size: (0.2, 0.15), rotation: 0.0, color_slot: secondary),
        (name: "shoulder_r", shape: Rect, anchor: Some("torso"), offset: Some((0.3, -0.17)), size: (0.2, 0.15), rotation: 0.0, color_slot: secondary),
        (name: "belt", shape: Rect, anchor: Some("torso"), offset: Some((0.0, 0.2)), size: (0.64, 0.08), rotation: 0.0, color_slot: secondary),
        (name: "core", shape: Ellipse, anchor: Some("torso"), offset: Some((0.0, 0.02)), size: (0.2, 0.2), rotation: 0.0, color_slot: accent),
        (name: "fist_l", shape: Ellipse, anchor: Some("hand_l"), offset: Some((0.0, 0.0)), size: (0.22, 0.22), rotation: 0.0, color_slot: primary),
        (name: "fist_r", shape: Ellipse, anchor: Some("hand_r"), offset: Some((0.0, 0.0)), size: (0.26, 0.26), rotation: 0.0, color_slot: primary),
        (name: "ember_r", shape: Ellipse, anchor: Some("hand_r"), offset: Some((0.05, 0.0)), size: (0.09, 0.09), rotation: 0.0, color_slot: accent),
        (name: "head", shape: Ellipse, anchor: Some("head"), offset: Some((0.0, 0.0)), size: (0.34, 0.3), rotation: 0.0, color_slot: primary),
        (name: "spike_l", shape: Triangle, anchor: Some("head"), offset: Some((-0.1, -0.17)), size: (0.12, 0.09), rotation: -90.0, color_slot: secondary),
        (name: "spike_c", shape: Triangle, anchor: Some("head"), offset: Some((0.0, -0.2)), size: (0.17, 0.1), rotation: -90.0, color_slot: secondary),
        (name: "spike_r", shape: Triangle, anchor: Some("head"), offset: Some((0.1, -0.17)), size: (0.12, 0.09), rotation: -90.0, color_slot: secondary),
        (name: "visor", shape: Rect, anchor: Some("head"), offset: Some((0.07, 0.0)), size: (0.2, 0.05), rotation: 0.0, color_slot: eye),
        (name: "foot_l", shape: Rect, anchor: Some("foot_l"), offset: Some((0.03, 0.0)), size: (0.22, 0.1), rotation: 0.0, color_slot: secondary),
        (name: "foot_r", shape: Rect, anchor: Some("foot_r"), offset: Some((0.03, 0.0)), size: (0.22, 0.1), rotation: 0.0, color_slot: secondary),
    ],
)
