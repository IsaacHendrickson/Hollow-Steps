(
    // A flier: no legs, a streamlined body, a fanned tail and two wings that beat between the
    // `fly_up` and `fly_down` poses. Wing tips are the `hand_l` (far wing) and `hand_r` (near
    // wing) points; both wings hinge on the fixed `shoulder` point on the back.
    pose_map: {"head": "head", "torso": "torso", "hand_l": "wing_l", "hand_r": "wing_r", "tail": "tail"},
    follow: (stiffness: 120.0, damping: 22.0),
    follow_overrides: {
        "wing_l": (stiffness: 220.0, damping: 18.0),
        "wing_r": (stiffness: 220.0, damping: 18.0),
    },
    idle: [
        (point: "wing_l", amplitude: (0.0, 0.03), period_secs: 0.9, phase_offset_secs: 0.0),
        (point: "wing_r", amplitude: (0.0, 0.03), period_secs: 0.9, phase_offset_secs: 0.45),
        (point: "tail", amplitude: (0.0, 0.02), period_secs: 1.4, phase_offset_secs: 0.2),
    ],
    points: {
        "head": (rest: (0.26, -0.14)),
        "torso": (rest: (-0.04, 0.06)),
        "shoulder": (rest: (-0.08, -0.08)),
        "wing_l": (rest: (-0.30, -0.46)),
        "wing_r": (rest: (-0.37, -0.49)),
        "tail": (rest: (-0.44, 0.10)),
    },
    parts: [
        (name: "wing_far", shape: Line, from: Some("shoulder"), to: Some("wing_l"), size: (0.2, 0.2), rotation: 0.0, color_slot: secondary),
        (name: "wing_far_tip", shape: Ellipse, anchor: Some("wing_l"), offset: Some((0.0, 0.0)), size: (0.24, 0.2), rotation: 0.0, color_slot: secondary),
        (name: "tail_low", shape: Triangle, anchor: Some("tail"), offset: Some((0.0, 0.04)), size: (0.28, 0.14), rotation: 160.0, color_slot: accent),
        (name: "tail", shape: Triangle, anchor: Some("tail"), offset: Some((0.0, 0.0)), size: (0.3, 0.2), rotation: 180.0, color_slot: accent),
        (name: "torso", shape: Ellipse, anchor: Some("torso"), offset: Some((0.0, 0.0)), size: (0.6, 0.42), rotation: -8.0, color_slot: primary),
        (name: "wing_near", shape: Line, from: Some("shoulder"), to: Some("wing_r"), size: (0.24, 0.24), rotation: 0.0, color_slot: secondary),
        (name: "wing_near_tip", shape: Ellipse, anchor: Some("wing_r"), offset: Some((0.0, 0.0)), size: (0.28, 0.22), rotation: 0.0, color_slot: secondary),
        (name: "head", shape: Ellipse, anchor: Some("head"), offset: Some((0.0, 0.0)), size: (0.36, 0.32), rotation: 0.0, color_slot: primary),
        (name: "beak", shape: Triangle, anchor: Some("head"), offset: Some((0.22, 0.015)), size: (0.22, 0.14), rotation: 0.0, color_slot: accent),
        (name: "eye", shape: Ellipse, anchor: Some("head"), offset: Some((0.07, -0.04)), size: (0.11, 0.11), rotation: 0.0, color_slot: eye),
    ],
)
