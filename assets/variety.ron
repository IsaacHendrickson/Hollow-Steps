// How much a run varies from the authored dungeon in the shipped game (docs/variety.md). This file
// replaces data/variety.ron whole, and F5 does not re-read it: restart the game after editing it.
// The F4 window's Run (debug) section has "Flip next run" and "Flip rooms next run" rows to force
// a flip on or off for the next run without touching this file.
(
    flip_percent: 50.0,  // chance, in percent (0 to 100), that a run plays the whole dungeon
                         // mirrored left to right (the hub is never mirrored); 0 never, 100 always
    room_flip_percent: 50.0, // chance, in percent (0 to 100), that a room marked flippable is played
                         // mirrored in a run, drawn for each such room apart from the others
)
